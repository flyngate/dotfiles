#!/bin/bash
# configuration scripts for raspberry pi os based on debian 12 bookworm

set -euo pipefail

FIRMWARE_CONFIG="/boot/firmware/config.txt"
reboot_is_needed=false

function setup_shell() {
  echo "Setting up shell..."

  if ! command -v zsh &>/dev/null; then
    echo "zsh not installed, skipping shell setup"
    return
  fi

  local target_shell
  target_shell=$(command -v zsh)

  if [ "$SHELL" != "$target_shell" ]; then
    sudo chsh -s "$target_shell" "$USER"
    reboot_is_needed=true
  fi
}

function setup_system() {
  # increase soft temperature limit to avoid CPU throttling on Raspberry PI 3B+
  if grep -q temp_soft_limit "$FIRMWARE_CONFIG" 2>/dev/null; then
    sudo sed -i 's/temp_soft_limit=.*/temp_soft_limit=70/' "$FIRMWARE_CONFIG"
  else
    sudo sh -c "echo \"\ntemp_soft_limit=70\" >> $FIRMWARE_CONFIG"
  fi
 
  # update the system
  sudo apt update
  sudo apt upgrade -y
  sudo apt dist-upgrade -y

  # generate locales
  sudo apt install -y locales
  grep -q "en_US.UTF-8 UTF-8" /etc/locale.gen 2>/dev/null || sudo sh -c 'echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen'
  grep -q "ru_RU.UTF-8 UTF-8" /etc/locale.gen 2>/dev/null || sudo sh -c 'echo "ru_RU.UTF-8 UTF-8" >> /etc/locale.gen'
  sudo locale-gen
}

function install_cli() {
  sudo apt install -y dnsutils zsh tmux vim fzf silversearcher-ag git git-delta ripgrep zoxide pass
}

function install_neovim() {
  if ! command -v nvim &>/dev/null; then
    (
      sudo apt-get install -y ninja-build gettext cmake unzip curl
      rm -rf /tmp/neovim
      git clone --depth=1 https://github.com/neovim/neovim /tmp/neovim
      cd /tmp/neovim
      make CMAKE_BUILD_TYPE=Release
      sudo make install
      rm -rf /tmp/neovim
    )
  fi
}

function install_node() {
  if ! command -v node &>/dev/null; then
    curl -fsSL https://deb.nodesource.com/setup_26.x -o /tmp/nodesource-setup.sh
    sudo bash /tmp/nodesource-setup.sh
    rm /tmp/nodesource-setup.sh
    sudo apt-get install -y nodejs
  fi
}

function install_rust() {
  if ! command -v rustc &>/dev/null; then
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh
  fi
}

function install_docker() {
  if ! command -v docker &>/dev/null; then
    curl -sSL https://get.docker.com | sh
  fi
  if ! groups "$USER" | grep -q docker; then
    sudo usermod -a -G docker "$USER"
  fi
}

setup_shell
setup_system
install_cli
install_neovim
install_node
install_rust
install_docker

if [ "$reboot_is_needed" = true ]; then
  read -p "Reboot is needed to apply changes. Reboot now? [y/N] " answer || true
  if [ "${answer:-}" = "y" ] || [ "${answer:-}" = "Y" ]; then
    sudo reboot
  fi
fi
